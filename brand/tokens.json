{
  "name": "Grip Design Tokens",
  "version": "1.0.0",
  "color": {
    "fairway":     { "value": "#2F5D4A", "role": "primary" },
    "fairway-2":   { "value": "#24493A", "role": "primary-pressed" },
    "fairway-1":   { "value": "#3D7560", "role": "primary-tint" },
    "cream":       { "value": "#F4EEE0", "role": "background" },
    "cream-deep":  { "value": "#EAE1CB", "role": "surface-secondary" },
    "cream-2":     { "value": "#FAF6EC", "role": "surface-elevated" },
    "ink":         { "value": "#1A1F1C", "role": "text" },
    "sunset":      { "value": "#C66B4A", "role": "accent" },
    "moss":        { "value": "#7A8B6A", "role": "support" }
  },
  "font": {
    "display": "Fraunces",
    "sans":    "DM Sans",
    "mono":    "JetBrains Mono"
  },
  "fontSize": {
    "display": "88px",
    "h1": "56px",
    "h2": "40px",
    "h3": "28px",
    "lead": "22px",
    "body": "15px",
    "small": "13px",
    "mono": "11px"
  },
  "spacing": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px"
  },
  "radius": {
    "sm": "8px", "md": "14px", "lg": "18px", "xl": "24px", "pill": "999px"
  },
  "shadow": {
    "1": "0 1px 0 rgba(0,0,0,0.04)",
    "2": "0 10px 30px -15px rgba(26,31,28,0.20)",
    "3": "0 20px 50px -20px rgba(26,31,28,0.30)"
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "durFast": "150ms",
    "durBase": "240ms",
    "durSlow": "400ms"
  },
  "voice": {
    "principles": [
      "Warm, direct, a touch dry",
      "One idea per sentence",
      "A friend who golfs, not a golfer with a friend"
    ],
    "say": [
      "Find your fourth.",
      "New to the area? So was everyone, once.",
      "On holiday? Bring your sticks. We'll bring the company.",
      "No strangers on the tee."
    ],
    "dontSay": [
      "UNLEASH YOUR INNER GOLFER.",
      "Connect with 10,000+ active golfers today!",
      "Our proprietary matching algorithm pairs compatible golfers."
    ]
  }
}
